{
  "manifest_version": 3,
  "name": "AI Coding Mentor",
  "version": "1.0.0",
  "description": "An AI-powered DSA learning companion with progressive hints, code explanations, debugging, and progress tracking.",
  "permissions": ["storage"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Coding Mentor"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  }
}